{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "source.edk2_dec",
  "patterns": [
    {
      "include": "#keywords_dec"
    }
  ],
  "repository": {
    "keywords_dec": {
      "patterns": [
        {
          "begin": "\\b(PACKAGE_NAME|PACKAGE_GUID|PACKAGE_VERSION|PACKAGE_UNI_FILE|DEC_SPECIFICATION|DEFINE)\\b",
          "end": "=",
          "name": "variable.function.constructor.edk2_dec"
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "variable.function.constructor.edk2_dec"
            },
            "2": {
              "name": "variable.function.constructor.edk2_dec"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*)\\s*(\\|)",
          "captures": {
            "1": {
              "name": "variable.name.edk2_dec"
            },
            "2": {
              "name": "keyword.operator.edk2_dec"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z][A-Za-z0-9_]*)\\s*(\\|)",
          "captures": {
            "1": {
              "name": "variable.function.constructor.edk2_dec"
            },
            "2": {
              "name": "keyword.operator.edk2_dec"
            }
          }
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "string.quoted.double.edk2_dec",
              "match": "[a-zA-Z0-9.]+"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.edk2_dec",
          "patterns": [
            {
              "name": "constant.character.escape.edk2_dec",
              "match": "\\\\."
            }
          ]
        },
        {
          "begin": " '",
          "end": "'",
          "name": "invalid.illegal.edk2_dec",
          "patterns": [
            {
              "name": "entity.name.type.edk2_dec",
              "match": "."
            }
          ]
        },
        {
          "name": "support.type.edk2_dec",
          "match": "\\b(UINT64|UINT32|UINT16|UINT8|UINTN|BOOLEAN|VOID\\*?|TRUE|FALSE|NULL)\\b"
        },
        {
          "name": "entity.name.function.edk2_dec",
          "match": "\\b(ifdef|ifndef|if|endif|include|else|Includes|Guids|Ppis|Protocols|PcdsFeatureFlag|PcdsFixedAtBuild|PcdsPatchableInModule|PcdsDynamic|PcdsDynamicEx|LibraryClasses|UserExtensions)\\b"
        },
        {
          "name": "constant.numeric.edk2_dec",
          "match": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        {
          "name": "constant.numeric.hex.edk2_dec",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.edk2_dec",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "keyword.control.edk2_dec",
          "match": "(?<=!)(ifdef|ifndef|if|endif|include|else)"
        },
        {
          "name": "comment.line.number-sign.edk2_dec",
          "begin": "#",
          "end": "\n"
        }
      ]
    }
  },
  "scopeName": "source.edk2_dec"
}