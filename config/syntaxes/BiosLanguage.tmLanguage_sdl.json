{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "source.sdl",
	"patterns": [
		{
			"include": "#keywords_sdl"
		}
	],
	"repository": {
		"keywords_sdl": {
			"patterns": [
				{
					"name": "comment.line.number-sign.sdl",
					"begin": "#",
					"end": "$"
				},
				{
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{
							"name": "entity.name.tag.sdl",
							"match": "[A-Za-z_][A-Za-z0-9_\\-]*"
						}
					]
				},
				{
					"match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
					"captures": {
						"1": {
							"name": "variable.language.sdl"
						},
						"2": {
							"name": "keyword.operator.assignment.sdl"
						}
					}
				},
				{
					"name": "string.quoted.double.sdl",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.sdl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.single.sdl",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.sdl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "constant.numeric.sdl",
					"match": "\\b0[xX][0-9a-fA-F]+\\b|\\b\\d+(?:\\.\\d+)?\\b"
				},
				{
					"name": "constant.language.sdl",
					"match": "\\b(TRUE|FALSE|NULL|Yes|No|On|Off)\\b"
				},
				{
					"name": "entity.name.type.sdl",
					"match": "\\b(Integer|Boolean|String|UINT64|UINT32|UINT16|UINT8|UINTN|BOOLEAN|VOID)\\b"
				},
				{
					"name": "keyword.control.sdl",
					"match": "\\b(TOKEN|End|FFS_FILE|OUTPUTREGISTER|INFComponent|ELINK|MODULE|PATH|LibraryMapping|PcdMapping|FD_AREA|PCIDEVICE|Rule_Override|Skip_Packaging|FILE_Stmt|InvokeOrder|GuidSpace|PcdType|DataType|ModuleTypes|Logic|Expression)\\b"
				},
				{
					"name": "variable.parameter.sdl",
					"match": "[A-Za-z0-9_./\\\\-]+\\.[A-Za-z0-9_]+"
				},
				{
					"name": "support.function.sdl",
					"match": "(?<=\\$\\()[A-Za-z0-9_]+(?=\\))"
				},
				{
					"name": "keyword.operator.sdl",
					"match": "\\|"
				}
			]
		}
	},
	"scopeName": "source.sdl"
}
