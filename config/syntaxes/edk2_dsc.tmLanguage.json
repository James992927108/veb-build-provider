{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "source.edk2_dsc",
  "patterns": [
    {
      "include": "#keywords_dsc"
    }
  ],
  "repository": {
    "keywords_dsc": {
      "patterns": [
        {
          "begin": "\\b(DSC_SPECIFICATION|PLATFORM_GUID|PLATFORM_VERSION|PLATFORM_NAME|SKUID_IDENTIFIER|SUPPORTED_ARCHITECTURES|BUILD_TARGETS|OUTPUT_DIRECTORY|FLASH_DEFINITION|BUILD_NUMBER|FIX_LOAD_TOP_MEMORY_ADDRESS|TIME_STAMP_FILE|DEFINE|RFC_LANGUAGES|ISO_LANGUAGES|VPD_TOOL_GUID|PCD_INFO_GENERATION|PREBUILD|POSTBUILD)\\b",
          "end": "=",
          "name": "variable.function.constructor.BiosLanguage"
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "variable.function.constructor.BiosLanguage"
            },
            "2": {
              "name": "variable.function.constructor.BiosLanguage"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z][A-Za-z0-9_]*)\\s*(\\|)",
          "captures": {
            "1": {
              "name": "variable.function.constructor.BiosLanguage"
            },
            "2": {
              "name": "keyword.operator.edk2_dsc"
            }
          }
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "string.quoted.double.edk2_inf",
              "match": "[a-zA-Z0-9.]+"
            }
          ]
        },
        {
          "begin": " \"",
          "end": "\"",
          "name": "invalid.illegal.BiosLanguage",
          "patterns": [
            {
              "name": "entity.name.type.BiosLanguage",
              "match": "."
            }
          ]
        },
        {
          "begin": " '",
          "end": "'",
          "name": "invalid.illegal.BiosLanguage",
          "patterns": [
            {
              "name": "entity.name.type.BiosLanguage",
              "match": "."
            }
          ]
        },
        {
          "name": "entity.name.function.BiosLanguage",
          "match": "\\b(UINT64|UINT32|UINT16|UINT8|UINTN|BOOLEAN|VOID|TRUE|FALSE|NULL|ifdef|ifndef|if|endif|include|else|Defines|BuildOptions|SkuIds|LibraryClasses|Components|PcdsFeatureFlag|PcdsFixedAtBuild|PcdsPatchableInModule|PcdsDynamic|PcdsDynamicEx|UserExtensions)\\b"
        },
        {
          "name": "constant.numeric.edk2_dsc",
          "match": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        {
          "name": "constant.numeric.edk2_dsc",
          "match": "(?<!\\w)\\.?\\d(?:(?:[0-9a-zA-Z_\\.]|')|(?<=[eEpP])[+-])*"
        },
        {
          "name": "keyword.control.edk2_dsc",
          "match": "(?<=!)(ifdef|ifndef|if|endif|include|else)"
        },
        {
          "name": "comment.line.number-sign.edk2_dsc",
          "begin": "#",
          "end": "\n"
        }
      ]
    }
  },
  "scopeName": "source.edk2_dsc"
}