#string AMD_CBS_STR_SOFT_REPAIR                                                 #language en-US    "Soft Repair"
#string AMD_CBS_STR_HARD_REPAIR                                                 #language en-US    "Hard Repair"
#string AMD_CBS_STR_NO_REPAIRS_TEST_ONLY                                        #language en-US    "No Repairs - Test only"
#string AMD_CBS_STR_DATA_EYE_SECTION                                            #language en-US    "Data Eye"
