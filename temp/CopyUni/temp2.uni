#string AMD_CBS_STR_NBIO_SYNCFLOOD_REPORTING_HELP                               #language en-US    "This value may be used to enable SyncFlood reporting to APML.  When set to TRUE SyncFlood will be reported to APML.  When set to FALSE that reporting well be disabled"
#string AMD_CBS_STR_PCIE_AER_REPORTING_MECHANISM                                #language en-US    "PCIe Aer Reporting Mechanism"
 #language x-AMI "CmnGnbAmdPcieAerReportMechanism"
#string AMD_CBS_STR_PCIE_AER_REPORTING_MECHANISM_HELP                           #language en-US    "This value selects the method of reporting AER errors from PCI Express.  A value of 1 allows OS First handling of the errors through generation of a system control interrupt (SCI).  A value of 2 provides for Firmware First handling of errors through generation of a system management interrupt (SMI)."
#string AMD_CBS_STR_FIRMWARE_FIRST                                              #language en-US    "Firmware First"
#string AMD_CBS_STR_FIRMWARE_FIRST_BUT_ALLOW_OS_FIRST                           #language en-US    "Firmware First but allow OS First"
