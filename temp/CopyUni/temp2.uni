#string AMD_CBS_STR_SYNC_FLOOD_ON_PCIE_FATAL_ERROR                              #language en-US    "Sync Flood on PCIe Fatal Error"
 #language x-AMI "CbsCmnGnbRasSyncfloodPcieFatalError"
#string AMD_CBS_STR_SYNC_FLOOD_ON_PCIE_FATAL_ERROR_HELP                         #language en-US    "When 'Sync Flood on PCIe Fatal Error' is True, PcdAmdPcieSyncFloodOnFatal should be set to True.\n\nWhen 'Sync Flood on PCIe Fatal Error' is False, PcdAmdPcieSyncFloodOnFatal should be set to False.\n\nWhen 'Sync Flood on PCIe Fatal Error' is Auto, PcdAmdPcieSyncFloodOnFatal should retain its AGESA default."
#string AMD_CBS_STR_NBIO_RAS_NUMERICAL_COMMON_OPTIONS                           #language en-US    "NBIO RAS Numerical Common Options"
