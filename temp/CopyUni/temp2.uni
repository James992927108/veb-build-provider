#langdef   en-US "English"    // English

#string STR_MEDIA_SANITIZATION                      #language en-US "Media Sanitization"

#string STR_MEDIA_SANITIZATION_CONFIGURATION        #language en-US "Media Sanitization Configuration"
#string STR_MEDIA_SANITIZATION_HELP                 #language en-US "Enter Media Sanitization Page."

