 #language x-AMI "CbsCmnMemHealingBistExecutionMode"
#string AMD_CBS_STR_DDR_HEALING_BIST_EXECUTION_MODE_HELP                        #language en-US    "[One Time]: DDR Healing BIST will only be executed one time.\n[Every Boot]: DDR Healing BIST will be executed on every boot."
#string AMD_CBS_STR_ONE_TIME                                                    #language en-US    "One Time"
#string AMD_CBS_STR_EVERY_BOOT                                                  #language en-US    "Every Boot"
