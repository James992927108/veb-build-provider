#string STR_FAST_BOOT                   #language eng "Fast Boot"
                                        #language x-AMI "PTT000"
#string STR_FAST_BOOT_HELP              #language eng "Enables or disables boot with initialization of a minimal set of devices required to launch active boot option. Has no effect for BBS boot options."
#string STR_FAST_BOOT_BANNER_ONE        #language eng "WARNING!!! WARNING!!! WARNING!!!"
#string STR_FAST_BOOT_BANNER_TWO        #language eng "You are about enabling FAST BOOT!"
