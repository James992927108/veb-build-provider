#string STR_HDDSEC_MASTER_PASSWORD             #language eng "Set Master Password"
#string STR_HDDSEC_MASTER_PASSWORD_HELP        #language eng "Set HDD Master Password. \n*** Advisable to Power Cycle System after Setting Hard Disk Passwords ***\nDiscard or Save changes option in setup does not have any impact on HDD when password is set or removed. If the 'Set HDD Master option' is hidden, user might have entered setup with user HDD Security privilege(expected) or else do power cycle to enable the option again"


#string STR_HDDSEC_IMPORTANT_TITLE               #language en-US "IMPORTANT!!!"
#string STR_HDDSEC_PWD_CLEAR_MESSAGE             #language en-US "No Pre-Exsisting Master Password"




