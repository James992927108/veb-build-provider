#langdef   en-US "English"    // English

#string STR_MEDIA_SANITIZATION                      #language en-US "Media Sanitization"

#string STR_MEDIA_SANITIZATION_CONFIGURATION        #language en-US "Media Sanitization Configuration"
#string STR_MEDIA_SANITIZATION_HELP                 #language en-US "Enter Media Sanitization Page."

#string STR_MEDIA_SANITIZE_DEVICE_NAME              #language en-US "Device Name"
#string STR_MEDIA_SANITIZE_DEVICE_NAME_HELP         #language en-US "Select the drive need to be sanitized\n"
                                                                    "Clear: applies logical techniques to sanitize data in all user-addressable storage locations through the standard Read and Write commands to the storage device\n"
                                                                    "Purge: applies physical or logical techniques that render Target Data recovery infeasible using state of the art laboratory techniques.\n"

#string STR_MEDIA_SANITIZATION_METHOD               #language en-US "Method Type"
#string STR_MEDIA_SANITIZATION_DISABLE              #language en-US "Disable"
#string STR_MEDIA_SANITIZATION_CLEAR                #language en-US "Clear"
#string STR_MEDIA_SANITIZATION_PURGE                #language en-US "Purge"
#string STR_SANITIZATION_METHOD_HELP                #language en-US "Select which method apply for this drive\n"
                                                                    "Default method : Clear\n"
                                                                    "Once select purge method , the supported command type for this drive will be shown below\n"

#string STR_MEDIA_SANITIZATION_COMMAND              #language en-US "Command Type"
#string STR_MEDIA_SANITIZATION_COMMAND_SANTIZE      #language en-US "Sanitize"
#string STR_MEDIA_SANITIZATION_COMMAND_SECURE_ERASE #language en-US "Secure Erase"
#string STR_MEDIA_SANITIZATION_COMMAND_FORMAT       #language en-US "Format"
#string STR_MEDIA_SANITIZATION_COMMAND_OPAL         #language en-US "Opal Erase"
#string STR_MEDIA_SANITIZATION_COMMAND_NONE         #language en-US "None"
#string STR_MEDIA_SANITIZATION_COMMAND_HELP         #language en-US "This sub-menu show the supported sanitize command of this drive\n"
                                                                    "Sanitize:The specific Sanitize command of each of kind drive for purge technique\n"
                                                                    "Secure Erase: leverages a firmware-based process to overwrite the media.\n"
                                                                    "This command typically executes substantially faster than through the native read/write interface\n"
                                                                    "Format:Only Nvme drive support this format command\n"
                                                                    "Only Purge:Apply purge technique through the standard Read and Write commands\n"

#string STR_MEDIA_FORMAT_DATA_MODE                  #language en-US "Secure Erase Setting"
#string STR_MEDIA_FORMAT_NO_SECURE                  #language en-US "None"
#string STR_MEDIA_FORMAT_USER_DATA                  #language en-US "UserData"
