#string AMD_CBS_STR_NON_PCIE_COMPLIANT_SUPPORT_HELP                             #language en-US    "Enable this setting to send command to disable Extended EIEOS, DLF, and Gen 5 Support on training failure for non-pcie compliant devices."
#string AMD_CBS_STR_LIMIT_HOTPLUG_DEVICES_TO_PCIE_BOOT_SPEED                    #language en-US    "Limit hotplug devices to PCIe boot speed"
 #language x-AMI "CbsCmnLimitHpDevicesToPcieBootSpeed"
#string AMD_CBS_STR_LIMIT_HOTPLUG_DEVICES_TO_PCIE_BOOT_SPEED_HELP               #language en-US    "Enabled: Limit hotplug slots to Gen4 if system booted with only Gen4 devices, which optimizes idle power\nDisabled: Do not limit hotplug slots to Gen4 if system booted with only Gen4 devices, increases idle power"
