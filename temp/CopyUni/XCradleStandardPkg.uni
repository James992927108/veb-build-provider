#string STR_NVM_QOS_DISABLE_STR                         #language en-US "Disabled - Disable PMem QoS feature"
#string STR_DFX_LLC_SHARE_DRD_CRD_HELP                  #language en-US "Enable migration from SF to LLC and to leave shared lines in the LLC for Drd and Crd: Enabled (1), Disabled (0), Auto"
#string STR_DFX_CLEAN_EVICT_ALWAYS_LIVE_ENABLE_HELP     #language en-US "Enabled - Clean Evict Always Live"
#string STR_DFX_MODIFIED_EVICT_ALWAYS_LIVE_ENABLE_HELP  #language en-US "Enabled - Modified Evict Always Live"
#string STR_LINKL0P_HELP                                #language en-US "Enabled - Set the c_l0p_en, Disabled - Reset it, Auto - Auto decides based on Si Compatibility."
#string STR_LINKL1_HELP                                 #language en-US "Enabled - Set the c_l1_en, Disabled - Reset it, Auto - Auto decides based on Si Compatibility."
#string STR_KTI_FAILOVER_ENABLE_HELP                    #language en-US "Enabled - Set the c_failover_en, Disabled - Reset it, Auto - Auto decides based on Si Compatibility."
#string STR_KTI_PCIE_P2P_RELAXED_ORDERING_HELP          #language en-US "Relax P2P write ordering in hardware if software enforces ordering, or doesn't care. Default is DISABLED, so hardware will enforce P2P write ordering."
#string STR_SCRAMBLE_EN_DDRT_HELP                       #language en-US "Enabled - Enables data scrambling for PMem. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Enabled."
#string STR_SCRAMBLE_EN_HELP                            #language en-US "Enabled - Enables data scrambling for DDR4 and DDR5. Disabled - Disables this feature."// Auto - Sets it to the MRC default setting; current default is Enabled."//XCradle-WB0220221114V001-Del
#string STR_PKGC_CRITERIAL_HELP                         #language en-US "Enabled: B2P WRITE_PKGC_SA_PS_CRITERIA accepts input value."
#string STR_KTI_SKU_MISMATCH_CHECK_HELP                 #language en-US "Enabled or Disabled to do CPU SKU Type Mismatch check"
#string STR_PMON_ACC_CTRL_HELP                          #language en-US "Auto - Configures PMON access based on CPU.\nDisabled - Prevents PMON access and silently drops.\nEnabled - Configures PMON to get full access."
#string STR_DFX_DDR_CHANNEL_MASK_HELP                   #language en-US "Enabled (1) or Disabled (0) DDR memory channels. One bit corresponding to one channel per socket."
#string STR_UMABASEDCLUSTERING_HELP                     #language en-US "UMA Based Clustering options include Disabled (ALL2ALL), Hemisphere (2 cluster), and Quadrant (4 cluster, not supported on ICX). These option are only valid when SNC is disabled. If SNC is enabled, UMA-Based Clustering is automatically disabled by BIOS."
#string STR_IIO_NG_PCI_LTR_HELP                         #language en-US "Auto/Disabled - Turns off the Latency Tolerance Report feature of the PCI-E Root port and endpoint. Enabled - Turns on the Latency Tolerance Report feature."
#string STR_IIO_NG_EXTENDED_TAG_HELP                    #language en-US "Auto/Enabled - BIOS sets 8-bit Tag Field for PCI-E Root Port/EndPoint. Disabled - BIOS sets 5-bit Tag Field for PCI-E Root Port/EndPoint"
#string STR_VMD_PCH_ROOTPORT_HELP                       #language en-US "Configuretion PCH root port: Enabled - VMD ownership root port"
#string STR_EXTENDED_TAG_HELP                           #language en-US "Auto/Enabled - BIOS sets 8-bit Tag Field for PCIe Root Port/EndPoint. Disabled - BIOS sets 5-bit Tag Field for PCIe Root Port/EndPoint"
#string STR_PCI_LTR_HELP                                #language en-US "Auto/Disabled - Turns off the Latency Tolerance Report feature of the Pcie Root port and endpoint. Enabled - Turns on the Latency Tolerance Report feature."
#string STR_RDCUR_HELP                                  #language en-US "Enabled - Set the suppress_mem_rd_prefetch_rdcur, Disabled - Reset it, Auto - Auto decides based on Si Compatibility."
#string STR_LLC_DEAD_LINE_ALLOC_HELP                    #language en-US "Enabled - opportunistically fill dead lines in LLC. Disabled - never fill dead lines in LLC"
#string STR_SPLITLOCK_HELP                              #language en-US "Enabled - Enable the split lock. Disabled - Disable the split lock"
#string STR_FORCE_ODT_ON_HELP                           #language en-US "Enabled - Forces ODT ON. Disabled - Disables ODT ON."
#string STR_CTLE_OVERRIDE_HELP                          #language en-US "Enabled - Override host CTLE Capacitance and Resistance values. Disabled - Do not modify host CTLE values."
#string STR_RTT_OVERRIDE_HELP                           #language en-US "Enabled - Able to override DRAM RTT_WR/RTT_PARK/DQ_VREF/MC_DQ_VREF values. Disabled - Do not modify DRAM RTT values."
#string STR_DDR_ECC_ENABLE_HELP                         #language en-US "Enabled - Enables DDR ECC. Disabled - Disables this feature.Current default is Enable. When this is set to Disable, DDR ECC Check will be set to Disable compulsorily."
#string STR_DDR_ECC_CHECK_HELP                          #language en-US "Enabled - Enables DDR ECC Check. Disabled - Disables this feature. Current default is Enable."
#string STR_HBM_ECC_ENABLE_HELP                         #language en-US "Enabled - Enables HBM ECC. Disabled - Disables this feature.Current default is Enable. When this is set to Disable, HBM ECC Check will be set to Disable compulsorily."
#string STR_HBM_ECC_CHECK_HELP                          #language en-US "Enabled - Enables HBM ECC Check. Disabled - Disables this feature. Current default is Enable."
#string STR_IMODE_OVERRIDE_HELP                         #language en-US "Enabled - Override IMode value. Disabled - Do not modify IMode value."
#string STR_ENFORCE_POR_HELP                            #language en-US "Enabled - Enforces Plan Of Record restrictions for DDR4 frequency and voltage programming. Disabled - Disables this feature and user is able to run at higher frequencies, specified in the DDR Frequency Limit field (limited by processor support). Auto - Sets it to the MRC default setting (current default is Enable)."
//#string STR_ALLOW_CORRECTABLE_ERROR_EN_HELP             #language en-US "Enabled - Allows correctable errors during memory training. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable." //XCradle-WSX20211104V001-Del for Crb37
#string STR_ALLOW_CORRECTABLE_MEM_TEST_ERROR_EN_HELP    #language en-US "Enabled - Logs error and allows correctable errors during memory test(DIMM Rank not removed). Disabled - Logs error and removes DIMM Rank."//  Auto - Sets it to the MRC default setting; current default is Enable."
#string STR_ECC_SUPPORT_HELP                            #language en-US "Enabled - Enables DDR ECC Support. Disabled - Disables this feature."
#string STR_TRNG_RESULT_OFFSET_HELP                     #language en-US "Enabled - Enables training results to be offset. Disabled - Disables this feature; current default is Enable"
#string STR_SET_MEM_TESTED_HELP                         #language en-US "Enabled - Sets the TESTED flag for all memory in PEI, making it available for DXE Drivers' usage"
#string STR_MEM_TEST_HELP                               #language en-US "Enabled - Enables memory test during normal boot. Disabled - Disables this feature."
#string STR_MEM_TEST_COLD_FAST_BOOT_HELP                #language en-US "Enabled - Enables memory test during cold fast boot. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable."
#string STR_ATTEMPT_FAST_BOOT_HELP_SKX                  #language en-US "Enabled - Portions of memory reference code will be skipped when possible to increase boot speed on warm boots. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Enable."
#string STR_ATTEMPT_FAST_BOOT_HELP_10NM                 #language en-US "Enabled - Portions of memory reference code will be skipped when possible to increase boot speed on warm boots. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable."
#string STR_ATTEMPT_FAST_BOOT_COLD_HELP                 #language en-US "Enabled - Portions of memory reference code will be skipped when possible to increase boot speed on cold boots. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable."
#string STR_SCRAMBLE_EN_HBM_HELP                        #language en-US "Enabled - Enables data scrambling for HBM. Disabled - Disables this feature; current default is Enable."
#string STR_LEGACY_RMT_HELP                             #language en-US "Enabled - Enables the legacy rank margin tool to run after DDR4 memory training. Disabled - Disables this feature. Current default is Enable. Should be disabled in production releases."
#string STR_PER_BIT_MARGIN_HELP                         #language en-US "Enabled - Enables the logging from the serial port of DDR Per Bit Margin Data. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable."
#string STR_EARLY_WR_CRC_DDRIO_HELP                     #language en-US "Enabled - Enables Early Write CRC in the DDRIO. Disabled - Disables this feature."
#string STR_WR_CRC_HELP                                 #language en-US "Enabled - Enables Write CRC. Disabled - Disables this feature."
#string STR_RMT_COLD_FAST_BOOT_HELP                     #language en-US "Enabled - Enables Rank Margin Tool on Cold Fast Boot. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Disable. Should be disabled in production releases."
#string STR_MULTI_THREADED_HELP                         #language en-US "Enabled - Executes the Memory Reference Code multi-threaded. Disabled - Disables this feature. Auto - Sets it to MRC default setting; current default is Enable."
#string STR_OPP_READ_DURING_WMM_HELP                    #language en-US "Enabled - Enables issuing read commands opportunistically during Write Major Mode. Disabled - Disables this feature. Auto - Sets it to the MRC default setting; current default is Enable."
#string STR_CA_PARITY_HELP                              #language en-US "Enabled - Enables DDR4 Command Address Parity. Disabled - Disables this feature."  //XCradle-YL20230713V003-Mod
#string STR_DIMM_ISOLATION_HELP                         #language en-US "Enabled - Enables DIMM Isolation for Command/Address Parity and Write CRC. Disabled - Disables this feature; current default is Enable."
#string STR_PKG_CST_CONFIG_CONTROL_LOCK_HELP            #language en-US "Enabled - MSR E2h will be locked. Power Good reset is needed to remove lock bits."
#string STR_DRAM_RAPL_PWR_LIMIT_LOCK_HELP               #language en-US "This Option allows unlock/lock DRAM_PLANE_POWER_LIMIT.pp_pwr_lim_lock.\n\nEnabled - Lock\nDisabled - Unlock"
#string STR_PROCESSOR_MSR_LOCK_HELP                     #language en-US "Enabled - MSR 3Ah and CSR 80h will be locked. Power Good reset is needed to remove lock bits."
//XCradle-WZY20210918V001-Add-Start
#string STR_UMABASEDCLUSTERING_HELP                     #language en-US "UMA Based Clustering options include Disabled (ALL2ALL), Hemisphere (2 cluster), and Quadrant (4 cluster, not supported on ICX). These option are only valid when SNC is disabled. If SNC is enabled, UMA-Based Clustering is automatically disabled by BIOS."
#string STR_DFX_CXL_VID_HELP                            #language en-US "CXL VID on SPR B0. Auto(Default) and Enabled is 0x1E98. Disabled is 0x8086"
#string STR_ADV_MEM_TEST_COND_HELP                      #language en-US "Auto = set test conditions based on test type; Manual = specify global test conditions; Disabled = Do not apply test conditions."
#string STR_FIGURE_OF_MERIT_OPTION_HELP                 #language en-US "Enabled - EyeWidth for Figure of Merit Programming. Disabled - Disable EyeWidth for Figure of Merit Programming."
#string STR_SMBUS_RESET_ASSERT_OPTION_HELP              #language en-US "Enabled - Assert when SMBUS Reset happens during SMBUS Read/Write. Disabled - Assert when SMBUS Reset happens during SMBUS Read/Write."
#string STR_LTR_IIO_INPUT_HELP                          #language en-US "MSR 1FCh Bit[29] = LTR_IIO_DISABLE. Disabled = Ignore IIO LTR input."
#string STR_UNCORE_FREQ_RAPL_LIMIT_HELP                 #language en-US "Enabled: BYPASS_CLM_RAPL_LIMIT = 0\n\nDisabled: BYPASS_CLM_RAPL_LIMIT = 1"
#string STR_DDR_ECC_ENABLE_HELP                         #language en-US "Enabled - Enables DDR ECC. Disabled - Disables this feature.Current default is Enabled. When this is set to Disabled, DDR ECC Check will be set to Disable compulsorily."
#string STR_DDR_ECC_CHECK_HELP                          #language en-US "Enabled - Enables DDR ECC Check. Disabled - Disables this feature. Current default is Enabled."
