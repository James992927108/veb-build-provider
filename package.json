{
  "name": "veb-build-provider",
  "displayName": "veb-build-provider",
  "description": "This tools provider building project veb module explorer.",
  "version": "3.9.1",
  "license": "MIT",
  "publisher": "aivres-bios",
  "repository": {
    "type": "git",
    "url": "https://github.com/James992927108/veb-build-provider.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:inf"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "vebBuild.buildTool.initTask",
        "key": "F8",
        "mac": "F8"
      },
      {
        "command": "vebBuild.buildTool.vebBuild",
        "key": "F7",
        "mac": "F7"
      },
      {
        "command": "vebBuild.buildTool.vebReBuild",
        "key": "F9",
        "mac": "F9"
      },
      {
        "command": "vebBuild.formatter.formatEdk2",
        "key": "shift+alt+F",
        "mac": "shift+alt+F",
        "when": "resourceLangId == BiosLanguage_sdl || resourceLangId == edk2_uni"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+f1",
        "when": "resourceLangId == c || resourceLangId == cpp",
        "args": {
          "langId": "c",
          "name": "debug_user_snippet"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+f2",
        "when": "resourceLangId == c || resourceLangId == cpp",
        "args": {
          "langId": "c",
          "name": "debug_start_snippet"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+f3",
        "when": "resourceLangId == c || resourceLangId == cpp",
        "args": {
          "langId": "c",
          "name": "debug_end_snippet"
        }
      },
      {
        "command": "vebBuild.edk2Debug.scanProject",
        "key": "ctrl+shift+f8",
        "mac": "cmd+shift+f8"
      },
      {
        "command": "vebBuild.edk2Debug.enhanceModule",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7"
      },
      {
        "command": "vebBuild.edk2Debug.restoreModuleEnhance",
        "key": "ctrl+shift+f6",
        "mac": "cmd+shift+f6"
      },
      {
        "command": "vebBuild.edk2Debug.analyzeLogFile",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5"
      }
    ],
    "languages": [
      {
        "id": "BiosLanguage_veb",
        "extensions": [
          ".veb",
          ".vebpart"
        ],
        "configuration": "./config/languages/language-configuration_veb.json"
      },
      {
        "id": "BiosLanguage_sdl",
        "extensions": [
          ".sdl"
        ],
        "configuration": "./config/languages/language-configuration_sdl.json"
      },
      {
        "id": "edk2_dsc",
        "extensions": [
          ".dsc",
          ".dsc.inc"
        ],
        "configuration": "./config/languages/edk2_dsc.conf.json"
      },
      {
        "id": "edk2_dec",
        "extensions": [
          ".dec"
        ],
        "configuration": "./config/languages/edk2_dec.conf.json"
      },
      {
        "id": "edk2_fdf",
        "extensions": [
          ".fdf",
          ".fdf.inc"
        ],
        "configuration": "./config/languages/edk2_fdf.conf.json"
      },
      {
        "id": "edk2_inf",
        "extensions": [
          ".inf"
        ],
        "configuration": "./config/languages/edk2_inf.conf.json"
      },
      {
        "id": "edk2_uni",
        "extensions": [
          ".uni"
        ],
        "configuration": "./config/languages/edk2_uni.conf.json"
      },
      {
        "id": "edk2_vfr",
        "extensions": [
          ".vfr",
          ".Vfr",
          ".hfr",
          ".sd"
        ],
        "configuration": "./config/languages/edk2_vfr.conf.json"
      },
      {
        "id": "asm",
        "aliases": [
          "x86 and x86_64 Assembly",
          "asm"
        ],
        "extensions": [
          ".asm",
          ".nasm",
          ".yasm",
          ".inc",
          ".s"
        ],
        "configuration": "./config/languages/language-configuration_asm.json"
      },
      {
        "id": "edk2_cif",
        "extensions": [
          ".cif"
        ],
        "configuration": "./config/languages/edk2_cif.conf.json"
      }
    ],
    "grammars": [
      {
        "language": "BiosLanguage_veb",
        "scopeName": "source.veb",
        "path": "./config/syntaxes/BiosLanguage.tmLanguage_veb.json"
      },
      {
        "language": "BiosLanguage_sdl",
        "scopeName": "source.sdl",
        "path": "./config/syntaxes/BiosLanguage.tmLanguage_sdl.json"
      },
      {
        "language": "edk2_dsc",
        "scopeName": "source.edk2_dsc",
        "path": "./config/syntaxes/edk2_dsc.tmLanguage.json"
      },
      {
        "language": "edk2_dec",
        "scopeName": "source.edk2_dec",
        "path": "./config/syntaxes/edk2_dec.tmLanguage.json"
      },
      {
        "language": "edk2_fdf",
        "scopeName": "source.edk2_fdf",
        "path": "./config/syntaxes/edk2_fdf.tmLanguage.json"
      },
      {
        "language": "edk2_inf",
        "scopeName": "source.edk2_inf",
        "path": "./config/syntaxes/edk2_inf.tmLanguage.json"
      },
      {
        "language": "edk2_uni",
        "scopeName": "source.edk2_uni",
        "path": "./config/syntaxes/edk2_uni.tmLanguage.json"
      },
      {
        "language": "edk2_vfr",
        "scopeName": "source.edk2_vfr",
        "path": "./config/syntaxes/edk2_vfr.tmLanguage.json"
      },
      {
        "language": "asm",
        "scopeName": "source.asm.x86_64",
        "path": "./config/syntaxes/language-x86_64-assembly.tmLanguage"
      },
      {
        "language": "edk2_cif",
        "scopeName": "source.cif",
        "path": "./config/syntaxes/edk2_cif.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "c",
        "path": "./config/snippets/edk2_c.snippet.json"
      },
      {
        "language": "cpp",
        "path": "./config/snippets/edk2_c.snippet.json"
      }
    ],
    "commands": [
      {
        "command": "vebBuild.buildTool.initTask",
        "title": "Run Veb initial task program."
      },
      {
        "command": "vebBuild.buildTool.vebBuild",
        "title": "Run Veb Build."
      },
      {
        "command": "vebBuild.buildTool.vebReBuild",
        "title": "Run Veb ReBuild."
      },
      {
        "command": "vebBuild.buildTool.stopTerminal",
        "title": "Stop Terminal"
      },
      {
        "command": "vebBuild.formatter.formatEdk2",
        "title": "Format Document"
      },
      {
        "command": "extension.expandMakefileVars",
        "title": "Expand Makefile Variables"
      },
      {
        "command": "vebBuild.edk2Debug.scanProject",
        "title": "Rescan EDK2 Project",
        "category": "VEB Build",
        "icon": "$(refresh)"
      },
      {
        "command": "vebBuild.edk2Debug.searchModules",
        "title": "Search EDK2 Modules",
        "category": "VEB Build",
        "icon": "$(search)"
      },
      {
        "command": "vebBuild.edk2Debug.clearSearch",
        "title": "Clear Search",
        "category": "VEB Build",
        "icon": "$(close)"
      },
      {
        "command": "vebBuild.edk2Debug.enhanceModule",
        "title": "Enhance Module Debug",
        "category": "VEB Build",
        "icon": "$(debug-alt)"
      },
      {
        "command": "vebBuild.edk2Debug.restoreModuleEnhance",
        "title": "Restore Enhanced Module Debug",
        "category": "VEB Build",
        "icon": "$(history)"
      },
      {
        "command": "vebBuild.edk2Debug.showStatistics",
        "title": "Show EDK2 Statistics",
        "category": "VEB Build",
        "icon": "$(graph)"
      },
      {
        "command": "vebBuild.edk2Debug.filterByModuleType",
        "title": "Filter by ModuleType",
        "icon": "$(filter)"
      },
      {
        "command": "vebBuild.edk2Debug.filterByStatus",
        "title": "Filter by Enhancement Status",
        "icon": "$(filter)"
      },
      {
        "command": "vebBuild.edk2Debug.analyzeLogFile",
        "title": "Open EDK2 Log File",
        "category": "VEB Build",
        "icon": "$(file-code)"
      },
      {
        "command": "vebBuild.edk2Debug.parseLogLine",
        "title": "Parse Log Line",
        "category": "VEB Build",
        "icon": "$(debug-line-by-line)"
      },
      {
        "command": "vebBuild.edk2Debug.showPerformanceAnalysis",
        "title": "Show Performance Analysis",
        "category": "VEB Build",
        "icon": "$(dashboard)"
      },
      {
        "command": "vebBuild.edk2Debug.batchAnalyzeLogs",
        "title": "Batch Analyze Logs",
        "category": "VEB Build",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vebBuild.enhancedDebug.switchToModules",
        "title": "Module Manager",
        "category": "Enhanced Debug",
        "icon": "$(symbol-module)"
      },
      {
        "command": "vebBuild.enhancedDebug.switchToLogs",
        "title": "Log Analysis",
        "category": "Enhanced Debug",
        "icon": "$(debug-console)"
      },
      {
        "command": "vebBuild.enhancedDebug.openLogFile",
        "title": "Open Log File",
        "category": "Enhanced Debug",
        "icon": "$(file-text)"
      },
      {
        "command": "vebBuild.enhancedDebug.filterLogs",
        "title": "Filter Logs",
        "category": "Enhanced Debug",
        "icon": "$(filter)"
      },
      {
        "command": "vebBuild.enhancedDebug.jumpToSource",
        "title": "Jump to Source",
        "category": "Enhanced Debug",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vebBuild.enhancedDebug.changeLogOpenLocation",
        "title": "Change Log File Open Location",
        "category": "Enhanced Debug",
        "icon": "$(window)"
      },
      {
        "command": "vebBuild.enhancedDebug.jumpToLogLine",
        "title": "Jump to Log Line",
        "category": "Enhanced Debug",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vebBuild.enhancedDebug.locateInTreeView",
        "title": "Locate in Enhanced Debug TreeView",
        "category": "Enhanced Debug",
        "icon": "$(search-view)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veb-build-explorer",
          "title": "Veb Build",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "veb-build-explorer": [
        {
          "id": "vebBuildEnhancedDebug",
          "name": "Enhanced Debug",
          "when": "vebBuild.hasEdk2Workspace",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == edk2_uni",
          "command": "vebBuild.formatter.formatEdk2",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == BiosLanguage_sdl",
          "command": "vebBuild.formatter.formatEdk2",
          "group": "navigation"
        },
        {
          "when": "editorLangId == makefile",
          "command": "extension.expandMakefileVars",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .log || resourceExtname == .txt",
          "command": "vebBuild.enhancedDebug.locateInTreeView",
          "group": "enhanced-debug@1"
        }
      ],
      "view/title": [
        {
          "command": "vebBuild.enhancedDebug.switchToModules",
          "when": "view == vebBuildEnhancedDebug",
          "group": "navigation@0"
        },
        {
          "command": "vebBuild.enhancedDebug.switchToLogs",
          "when": "view == vebBuildEnhancedDebug",
          "group": "navigation@1"
        },
        {
          "command": "vebBuild.edk2Debug.scanProject",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == modules",
          "group": "modules@0"
        },
        {
          "command": "vebBuild.edk2Debug.searchModules",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == modules",
          "group": "modules@1"
        },
        {
          "command": "vebBuild.edk2Debug.clearSearch",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == modules",
          "group": "modules@2"
        },
        {
          "command": "vebBuild.edk2Debug.filterByModuleType",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == modules",
          "group": "modules@3"
        },
        {
          "command": "vebBuild.edk2Debug.filterByStatus",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == modules",
          "group": "modules@4"
        },
        {
          "command": "vebBuild.enhancedDebug.openLogFile",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == logs",
          "group": "logs@0"
        },
        {
          "command": "vebBuild.enhancedDebug.filterLogs",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == logs",
          "group": "logs@1"
        },
        {
          "command": "vebBuild.enhancedDebug.changeLogOpenLocation",
          "when": "view == vebBuildEnhancedDebug && enhancedDebug.mode == logs",
          "group": "logs@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vebBuild.edk2Debug.enhanceModule",
          "when": "view == vebBuildEnhancedDebug && viewItem == edk2Module",
          "group": "navigation"
        },
        {
          "command": "vebBuild.edk2Debug.restoreModuleEnhance",
          "when": "view == vebBuildEnhancedDebug && viewItem == edk2Module",
          "group": "navigation"
        },
        {
          "command": "vebBuild.enhancedDebug.jumpToSource",
          "when": "view == vebBuildEnhancedDebug && viewItem == logEntry",
          "group": "navigation@1"
        },
        {
          "command": "vebBuild.enhancedDebug.jumpToLogLine",
          "when": "view == vebBuildEnhancedDebug && viewItem == logEntry",
          "group": "navigation@0"
        }
      ],
      "view/item/inline": [
        {
          "command": "vebBuild.edk2Debug.enhanceModule",
          "when": "view == vebBuildEnhancedDebug && viewItem == edk2Module",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "vebBuild.edk2Debug.analyzeLogFile",
          "when": "vebBuild.hasEdk2Workspace"
        },
        {
          "command": "vebBuild.edk2Debug.parseLogLine",
          "when": "vebBuild.hasEdk2Workspace"
        },
        {
          "command": "vebBuild.edk2Debug.showPerformanceAnalysis",
          "when": "vebBuild.hasEdk2Workspace"
        },
        {
          "command": "vebBuild.edk2Debug.batchAnalyzeLogs",
          "when": "vebBuild.hasEdk2Workspace"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "veb-build-provider",
      "properties": {
        "vebBuild.formatter.speceOnUni": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Provide space numbers between max length Token and LanguageCodes"
        },
        "vebBuild.formatter.spaceOnSdlBefore": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Provide space numbers before the string"
        },
        "vebBuild.formatter.spaceOnSdlAfter": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Provide space numbers after the string"
        },
        "vebBuild.edk2Debug.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan EDK2 modules"
        },
        "vebBuild.edk2Debug.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "Show scan progress"
        },
        "vebBuild.logAnalyzer.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python executable for log analysis"
        },
        "vebBuild.logAnalyzer.autoOpenReport": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open analysis report after completion"
        },
        "vebBuild.logAnalyzer.maxFileSize": {
          "type": "number",
          "default": 100,
          "description": "Maximum log file size in MB for analysis"
        },
        "vebBuild.enhancedDebug.logFileOpenLocation": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "one",
            "two",
            "three"
          ],
          "enumDescriptions": [
            "Open beside current editor (default)",
            "Replace current active editor",
            "Open in first editor column",
            "Open in second editor column",
            "Open in third editor column"
          ],
          "default": "beside",
          "description": "Where to open Enhanced Debug log files in the editor"
        },
        "vebBuild.modules.enableBuildTools": {
          "type": "boolean",
          "default": true,
          "description": "Enable VEB build tools (F7/F8/F9 shortcuts, task management)"
        },
        "vebBuild.modules.enableDebugTools": {
          "type": "boolean",
          "default": false,
          "description": "Enable EDK2 debug analysis tools (log parsing, module scanning)"
        },
        "vebBuild.modules.enableLanguageSupport": {
          "type": "boolean",
          "default": true,
          "description": "Enable EDK2 language support (syntax highlighting, formatting)"
        },
        "vebBuild.modules.enableMakefileTools": {
          "type": "boolean",
          "default": false,
          "description": "Enable Makefile variable expansion tools"
        }
      }
    }
  },
  "keybindings": [
    {
      "command": "vebBuild.enhancedDebug.locateInTreeView",
      "key": "ctrl+shift+l",
      "when": "editorTextFocus && (resourceExtname == .log || resourceExtname == .txt)"
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-scripts",
    "watch": "tsc -watch -p ./",
    "copy-scripts": "mkdir -p out/scripts && cp -r tools/scripts/. out/scripts/"
  },
  "devDependencies": {
    "@types/glob": "^7.1.1",
    "@types/mocha": "^7.0.2",
    "@types/node": "^22.15.33",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^2.30.0",
    "@typescript-eslint/parser": "^2.30.0",
    "eslint": "^6.8.0",
    "glob": "^7.1.6",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3",
    "vscode-test": "^1.3.0"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c": "^0.24.1"
  }
}
